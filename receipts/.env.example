# Copy to .env (git-ignored) and fill in. The app, CLI and eval load it automatically.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model used for extraction.
GEMINI_MODEL=gemini-2.5-flash
# Optional: where saved receipts are stored.
# RECEIPTS_DB=data/receipts.db
