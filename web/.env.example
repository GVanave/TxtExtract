# Copy to .env.local for local development, and add the same names in Vercel:
# Project → Settings → Environment Variables. Never commit real values.

# --- Database (Neon Postgres, free plan) ---
# On Vercel: Storage → Create → Neon → connect it to this project; DATABASE_URL is then set for you.
DATABASE_URL=
# Optional: connections per server instance (default 3).
# DATABASE_POOL_MAX=3

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: tried automatically when the main model is busy (503), rate-limited (429) or retired (404).
GEMINI_FALLBACK_MODEL=

# --- Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google accounts can use the app (comma-separated). Each sees only their own receipts.
ALLOWED_EMAILS=you@gmail.com
# Random secret for session cookies: run `openssl rand -base64 32`
NEXTAUTH_SECRET=
# The app's public address, used for the Google sign-in callback. Required on Vercel: set it to your fixed
# production domain (e.g. https://txtextract-web.vercel.app), not a per-deployment URL.
NEXTAUTH_URL=http://localhost:3000

# Optional: time zone for "today" and the running month (default Europe/Berlin).
# APP_TIME_ZONE=Europe/Berlin

# --- Only for the one-time import from the old Google Sheet (npm run import:sheets) ---
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# --- Local development without any setup (ignored in production builds) ---
# AUTH_DISABLED=1       # skip sign-in
# GEMINI_FAKE=1         # return a sample receipt instead of calling Gemini
# DATA_BACKEND=pglite   # an in-memory Postgres instead of DATABASE_URL
# PGLITE_DIR=.pglite    # keep that local database between restarts
